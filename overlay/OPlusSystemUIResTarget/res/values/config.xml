<resources>
     <!-- Use this to set fast charging threshold, use uW since our device reports in uW -->
    <integer name="config_chargingFastThreshold">15000000</integer>
    <!-- Use this to set slow charging threshold, use uW since our device reports in uW -->
    <integer name="config_chargingSlowlyThreshold">8000000</integer>
    <!-- Should we vibrate on an icon animation of the shelf. This should only be active if the
     vibrator is capable of subtle vibrations -->
    <bool name="config_vibrateOnIconAnimation">true</bool>
</resources>
